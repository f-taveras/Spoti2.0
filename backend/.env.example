# ── Spoti2.0 Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
#
# HOW TO USE (development):
#   Option A — set as shell env vars before running the backend:
#     export SPOTIFY_CLIENT_ID=abc123...
#     export SPOTIFY_CLIENT_SECRET=xyz789...
#     ./mvnw spring-boot:run
#
#   Option B — create backend/application-local.properties (also gitignored):
#     spring.security.oauth2.client.registration.spotify.client-id=abc123...
#     spring.security.oauth2.client.registration.spotify.client-secret=xyz789...
#     jwt.secret=<generate with: openssl rand -base64 48>
#
# SPOTIFY DASHBOARD SETUP:
#   Redirect URI to register: http://127.0.0.1:8080/login/oauth2/code/spotify
#   (Spotify no longer allows 'localhost' — use 127.0.0.1 explicitly)
#
# HOW TO USE (production):
#   Inject via your platform's secret manager — see SECRETS.md for the plan.

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Generate a strong JWT secret: openssl rand -base64 48
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars
